# Copy to .env (which git ignores). Nothing here is needed to run the site locally: every
# setting has a working default. Variables are read from the environment, so pass the file
# explicitly:  uv run --env-file .env python manage.py publish

# Where `manage.py publish` sends course content: the SSH address of the server.
DSAI_PUBLISH_SSH=user@server.example.com

# Signing in with Google on http://localhost:8000. Optional: without these the landing
# page offers "Development sign-in" instead. deploy/setup-google.sh fills them in.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# The owner's notification bot (BMO), told when a request or an educator application
# arrives. Not needed locally: left empty, nothing is sent. To try it from this computer,
# give the bot's https address and its token.
BMO_NOTIFY_URL=
BMO_NOTIFY_TOKEN=

# The server's own variables are separate: see deploy/env.example.
