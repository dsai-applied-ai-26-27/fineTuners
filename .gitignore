# --- course data: in this copy the courses' course.yaml and content/ are tracked; raw
# material, private material and duties never are ---
/courses/**/source/
/courses/**/private/
/courses/**/duties.yaml
/courses/**/.merged
/reference/
# The educator kit is a repository of its own, generated by `manage.py export_authoring`.
/educator-kit/

# --- derived from courses/ by `manage.py sync_content`; safe to delete ---
/db.sqlite3
# SQLite's own side files (rollback journal, write-ahead log, shared memory index).
/db.sqlite3-*
/media/
# Courses as handed in by educators, unpacked: rebuilt from the database when missing.
/handins/

# --- python ---
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# --- django ---
/staticfiles/
.env

# --- editors / os ---
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# --- cloudflare wrangler cache ---
.wrangler/
