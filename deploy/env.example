# ~/dsai-vault/.env on the server. `deploy install` writes it with freshly generated
# secrets, readable by its owner only. This file only shows its shape. Never commit a
# real one.

# The address visitors use. Django answers to this name and no other.
PUBLIC_HOST=dsai3.pages.dev

# Signs sessions and CSRF tokens. Changing it logs everyone out.
DJANGO_SECRET_KEY=

# Shared with the Cloudflare proxy (edge/_worker.js), which sends it on every request.
# Change it in both places together.
ORIGIN_SECRET=

# Sign-in with Google: the OAuth client from Google Cloud Console. Stored by
# deploy/setup-google.sh. Without them nobody can sign in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: shown on the public privacy page as the address for questions.
# DSAI_CONTACT_EMAIL=

# Optional: the owner's notification bot (BMO). When a request or an educator application
# arrives, the site posts a short message to this address with the token in a header. The
# address must start with https://. Leave both empty and nothing is sent.
# Set them with `deploy setenv BMO_NOTIFY_URL` and `deploy setenv BMO_NOTIFY_TOKEN`.
BMO_NOTIFY_URL=
BMO_NOTIFY_TOKEN=

# Optional: a mail server (SMTP with STARTTLS), for e-mail to educators: an accepted
# application, a new version of the educator kit, a hand-in taken off the site. Any
# provider's SMTP details do; FROM is the address the mail comes from. Set each with
# `deploy setenv NAME`. Leave the host empty and the site writes to nobody.
DSAI_EMAIL_HOST=
DSAI_EMAIL_PORT=587
DSAI_EMAIL_USER=
DSAI_EMAIL_PASSWORD=
DSAI_EMAIL_FROM=

# 1 (the default): every page needs a sign-in. 0: an open site, progress in the browser.
# DSAI_REQUIRE_LOGIN=1

# The Docker network of the web server that owns ports 80/443 on this machine; the proxy
# joins it. `deploy install` finds it and writes this line.
FRONT_NETWORK=
